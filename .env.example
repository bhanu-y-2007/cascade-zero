# CASCADE ZERO — Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# Never commit the real .env file (it is already in .gitignore).

# ─── Nebius AI (Token Factory) ────────────────────────────────────────────────
# Required to enable live AI-assisted hazard analysis.
# Obtain your key at: https://studio.nebius.ai/
NEBIUS_API_KEY=

# Nebius API base URL (default is correct for most accounts)
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# Model identifier — must be available in your Nebius account
# Default: nvidia/Llama-3.1-Nemotron-Ultra-253B-v1
NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-Ultra-253B-v1

# Request timeout in seconds (default: 60)
NEBIUS_TIMEOUT=60

# ─── Backend ──────────────────────────────────────────────────────────────────
# Port the FastAPI backend listens on (default: 8000)
BACKEND_PORT=8000

# Allowed CORS origins (comma-separated, no trailing slash)
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:4173

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Full URL of the backend API.
# Leave empty when using Vite's dev server (proxy handles /api/* automatically).
# Must be set for production builds or vite preview (e.g., http://localhost:8000).
VITE_API_BASE_URL=
